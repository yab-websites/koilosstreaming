<body>

<aside class="sidebar">
  <div class="brand"><span class="dot"></span>Nocturne</div>

  <nav class="primary">
    <a class="item active" href="#">
      <svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10"></path></svg>
      Home
    </a>
    <a class="item" href="#">
      <svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
      Search
    </a>
    <a class="item" href="#">
      <svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h7"></path></svg>
      Your Library
    </a>
  </nav>

  <div>
    <div class="lib-label">Playlists</div>
    <div class="playlists" id="playlist-list"></div>
  </div>
</aside>

<div class="main">
  <div class="topbar">
    <div class="search">
      <svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
      <input type="text" placeholder="Search songs, artists, albums" id="search-input">
    </div>
    <div class="avatar"></div>
  </div>

  <div class="content">
    <div class="hero">
      <div class="hero-copy">
        <div class="hero-eyebrow">Tonight's Frequency</div>
        <h1>Songs for the hour after everyone's asleep</h1>
        <p>Low tempo, high resolution. A running mix built for the drive home and the hours after it.</p>
        <button class="hero-play" id="hero-play-btn">
          <svg viewbox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
          Play the mix
        </button>
      </div>
      <div class="vinyl-wrap"><div class="vinyl" id="hero-vinyl"></div></div>
    </div>

    <div class="section">
      <div class="section-head">
        <h2>Made for late nights</h2>
        <span class="see-all">See all</span>
      </div>
      <div class="card-row" id="card-row"></div>
    </div>

    <div class="section">
      <div class="section-head">
        <h2>Tonight's Frequency</h2>
        <span class="see-all" id="track-count"></span>
      </div>
      <div class="tracklist" id="tracklist"></div>
    </div>
  </div>
</div>

<div class="now-playing">
  <div class="np-track">
    <div class="np-cover p1" id="np-cover"></div>
    <div class="np-meta">
      <div class="title" id="np-title">Choose a track</div>
      <div class="artist" id="np-artist">—</div>
    </div>
  </div>

  <div class="np-center">
    <div class="np-controls">
      <button title="Previous" id="prev-btn">
        <svg viewbox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"></path></svg>
      </button>
      <button class="play-toggle" id="play-btn" title="Play">
        <svg id="play-icon" viewbox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
      </button>
      <button title="Next" id="next-btn">
        <svg viewbox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM6 6l8.5 6L6 18z"></path></svg>
      </button>
    </div>
    <div class="np-progress">
      <span id="cur-time">0:00</span>
      <div class="bar" id="seek-bar"><div class="bar-fill" id="seek-fill"></div></div>
      <span id="tot-time">0:00</span>
    </div>
  </div>

  <div class="np-right">
    <div class="waveform" id="waveform"></div>
    <div class="vol">
      <svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H3v6h3l5 4V5z"></path><path d="M15.5 8.5a5 5 0 010 7"></path></svg>
      <div class="bar" id="vol-bar"><div class="bar-fill" id="vol-fill" style="width:70%"></div></div>
    </div>
  </div>
</div>

<script>
/* ---------------- Data ---------------- */
const tracks = [
  { title: "Amber Static",        artist: "Low Tide Radio",   album: "Tonight's Frequency", dur: 214, cover:"p1" },
  { title: "Rearview Neon",       artist: "Marbled Coast",     album: "Tonight's Frequency", dur: 198, cover:"p2" },
  { title: "Third Floor Window",  artist: "Halide",            album: "Tonight's Frequency", dur: 251, cover:"p3" },
  { title: "Cassette Weather",    artist: "Low Tide Radio",    album: "Cassette Weather",    dur: 187, cover:"p4" },
  { title: "Overpass, 2am",       artist: "June Static",       album: "Overpass",            dur: 233, cover:"p5" },
  { title: "Copper Light",        artist: "Marbled Coast",     album: "Copper Light EP",     dur: 205, cover:"p6" },
  { title: "Slow Exit",           artist: "Halide",            album: "Third Floor Window",  dur: 220, cover:"p1" },
  { title: "Parked Under Sodium", artist: "June Static",       album: "Overpass",            dur: 176, cover:"p2" },
];

const playlists = ["Late Drive Home", "Rain on Glass", "Empty Office", "Sleep, Eventually", "Old Mixtapes", "Copper & Static"];
const cards = [
  { title:"Low Tide Radio", sub:"Artist", cover:"p1" },
  { title:"Cassette Weather", sub:"Marbled Coast · EP", cover:"p2" },
  { title:"Overpass", sub:"June Static · Album", cover:"p3" },
  { title:"Third Floor Window", sub:"Halide · Album", cover:"p4" },
  { title:"Copper Light EP", sub:"Marbled Coast", cover:"p5" },
  { title:"Sleep, Eventually", sub:"Playlist", cover:"p6" },
];

function fmt(s){
  const m = Math.floor(s/60), r = Math.floor(s%60);
  return m + ":" + String(r).padStart(2,"0");
}

/* ---------------- Render ---------------- */
const plList = document.getElementById("playlist-list");
playlists.forEach(p=>{
  const d = document.createElement("div");
  d.className = "pl";
  d.textContent = p;
  plList.appendChild(d);
});

const cardRow = document.getElementById("card-row");
cards.forEach(c=>{
  const el = document.createElement("div");
  el.className = "card";
  el.innerHTML = `
    <div class="cover ${c.cover}">
      <button class="play-mini" title="Play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
    </div>
    <div class="title">${c.title}</div>
    <div class="sub">${c.sub}</div>
  `;
  cardRow.appendChild(el);
});

const trackListEl = document.getElementById("tracklist");
document.getElementById("track-count").textContent = tracks.length + " songs";

function renderTracks(list){
  trackListEl.innerHTML = "";
  list.forEach((t) => {
    const realIndex = tracks.indexOf(t);
    const row = document.createElement("div");
    row.className = "track-row";
    row.dataset.index = realIndex;
    row.innerHTML = `
      <span class="idx">${realIndex+1}</span>
      <button class="row-play" title="Play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
      <div class="t-cover ${t.cover}"></div>
      <div class="t-main">
        <div class="t-title">${t.title}</div>
        <div class="t-artist">${t.artist}</div>
      </div>
      <div class="t-album">${t.album}</div>
      <div class="t-dur">${fmt(t.dur)}</div>
    `;
    row.querySelector(".t-main").style.gridColumn = "3";
    row.addEventListener("click", () => loadTrack(realIndex, true));
    trackListEl.appendChild(row);
  });
}
renderTracks(tracks);

/* search filter */
document.getElementById("search-input").addEventListener("input", (e)=>{
  const q = e.target.value.toLowerCase().trim();
  const filtered = tracks.filter(t =>
    t.title.toLowerCase().includes(q) ||
    t.artist.toLowerCase().includes(q) ||
    t.album.toLowerCase().includes(q)
  );
  renderTracks(filtered);
});

/* waveform bars */
const waveform = document.getElementById("waveform");
for(let i=0;i<18;i++){
  const bar = document.createElement("i");
  waveform.appendChild(bar);
}

/* ---------------- Playback engine (synthesized audio) ---------------- */
let audioCtx = null;
let oscA=null, oscB=null, gainNode=null;
let currentIndex = -1;
let isPlaying = false;
let elapsed = 0;
let timerId = null;
let waveTimerId = null;

const npTitle = document.getElementById("np-title");
const npArtist = document.getElementById("np-artist");
const npCover = document.getElementById("np-cover");
const curTimeEl = document.getElementById("cur-time");
const totTimeEl = document.getElementById("tot-time");
const seekFill = document.getElementById("seek-fill");
const seekBar = document.getElementById("seek-bar");
const playBtn = document.getElementById("play-btn");
const playIcon = document.getElementById("play-icon");
const heroVinyl = document.getElementById("hero-vinyl");

const ICON_PLAY = '<path d="M8 5v14l11-7z"/>';
const ICON_PAUSE = '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>';

function ensureAudioCtx(){
  if(!audioCtx){
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
}

function stopTone(){
  if(oscA){ try{ oscA.stop(); }catch(e){} oscA.disconnect(); oscA=null; }
  if(oscB){ try{ oscB.stop(); }catch(e){} oscB.disconnect(); oscB=null; }
  if(gainNode){ gainNode.disconnect(); gainNode=null; }
}

/* Generates a soft ambient pad so "play" is audible without external files */
function startTone(){
  ensureAudioCtx();
  if(audioCtx.state === "suspended") audioCtx.resume();
  stopTone();

  const baseFreqs = [98, 130.8, 164.8, 196]; // small set of warm root notes
  const freq = baseFreqs[currentIndex % baseFreqs.length];

  gainNode = audioCtx.createGain();
  gainNode.gain.value = 0;
  const vol = (document.getElementById("vol-fill").style.width.replace('%','') || 70) / 100 * 0.05;
  gainNode.gain.linearRampToValueAtTime(vol, audioCtx.currentTime + 0.6);
  gainNode.connect(audioCtx.destination);

  oscA = audioCtx.createOscillator();
  oscA.type = "sine";
  oscA.frequency.value = freq;
  oscA.connect(gainNode);
  oscA.start();

  oscB = audioCtx.createOscillator();
  oscB.type = "triangle";
  oscB.frequency.value = freq * 1.5;
  const gainB = audioCtx.createGain();
  gainB.gain.value = 0.4;
  oscB.connect(gainB);
  gainB.connect(gainNode);
  oscB.start();
}

function fadeOutTone(cb){
  if(gainNode && audioCtx){
    gainNode.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 0.25);
    setTimeout(()=>{ stopTone(); if(cb) cb(); }, 260);
  } else if(cb) cb();
}

function highlightRow(){
  document.querySelectorAll(".track-row").forEach(r=>{
    r.classList.toggle("playing", Number(r.dataset.index) === currentIndex);
  });
}

function loadTrack(index, autoplay){
  currentIndex = index;
  const t = tracks[index];
  npTitle.textContent = t.title;
  npArtist.textContent = t.artist;
  npCover.className = "np-cover " + t.cover;
  totTimeEl.textContent = fmt(t.dur);
  elapsed = 0;
  updateProgress();
  highlightRow();
  if(autoplay) play(); else pause();
}

function updateProgress(){
  const t = tracks[currentIndex];
  if(!t) return;
  curTimeEl.textContent = fmt(elapsed);
  seekFill.style.width = Math.min(100, (elapsed / t.dur) * 100) + "%";
}

function tick(){
  const t = tracks[currentIndex];
  if(!t) return;
  elapsed += 1;
  if(elapsed >= t.dur){
    nextTrack();
    return;
  }
  updateProgress();
}

function animateWaveform(){
  const bars = waveform.querySelectorAll("i");
  bars.forEach(b=>{
    const h = isPlaying ? (4 + Math.random()*16) : 4;
    b.style.height = h + "px";
  });
}

function play(){
  if(currentIndex === -1){ loadTrack(0, true); return; }
  isPlaying = true;
  playIcon.innerHTML = ICON_PAUSE;
  playBtn.title = "Pause";
  heroVinyl.classList.add("spinning");
  waveform.classList.add("active");
  startTone();
  clearInterval(timerId);
  clearInterval(waveTimerId);
  timerId = setInterval(tick, 1000);
  waveTimerId = setInterval(animateWaveform, 140);
}

function pause(){
  isPlaying = false;
  playIcon.innerHTML = ICON_PLAY;
  playBtn.title = "Play";
  heroVinyl.classList.remove("spinning");
  waveform.classList.remove("active");
  fadeOutTone();
  clearInterval(timerId);
  clearInterval(waveTimerId);
  animateWaveform();
}

function togglePlay(){
  if(currentIndex === -1){ loadTrack(0, true); return; }
  isPlaying ? pause() : play();
}

function nextTrack(){
  const next = (currentIndex + 1) % tracks.length;
  loadTrack(next, true);
}
function prevTrack(){
  if(elapsed > 3){ elapsed = 0; updateProgress(); return; }
  const prev = (currentIndex - 1 + tracks.length) % tracks.length;
  loadTrack(prev, true);
}

playBtn.addEventListener("click", togglePlay);
document.getElementById("next-btn").addEventListener("click", nextTrack);
document.getElementById("prev-btn").addEventListener("click", prevTrack);
document.getElementById("hero-play-btn").addEventListener("click", ()=> loadTrack(0, true));

seekBar.addEventListener("click", (e)=>{
  if(currentIndex === -1) return;
  const rect = seekBar.getBoundingClientRect();
  const pct = (e.clientX - rect.left) / rect.width;
  elapsed = Math.floor(tracks[currentIndex].dur * pct);
  updateProgress();
});

/* volume */
const volBar = document.getElementById("vol-bar");
const volFill = document.getElementById("vol-fill");
volBar.addEventListener("click", (e)=>{
  const rect = volBar.getBoundingClientRect();
  const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
  volFill.style.width = (pct*100) + "%";
  if(gainNode && audioCtx){
    gainNode.gain.linearRampToValueAtTime(pct * 0.05, audioCtx.currentTime + 0.1);
  }
});

/* row play buttons + mini card play buttons all trigger loadTrack via delegation */
trackListEl.addEventListener("click", (e)=>{
  const btn = e.target.closest(".row-play");
  if(btn){
    const row = e.target.closest(".track-row");
    loadTrack(Number(row.dataset.index), true);
  }
});
cardRow.addEventListener("click", (e)=>{
  const btn = e.target.closest(".play-mini");
  if(btn) loadTrack(0, true);
});

animateWaveform();

