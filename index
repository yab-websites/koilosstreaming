<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nocturne — Late Night Radio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&amp;family=Inter:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0B0F1A;
    --surface: #131A2B;
    --surface-2: #1B2438;
    --line: #262F45;
    --amber: #E8A33D;
    --amber-dim: #B87F2E;
    --text: #F2EFE9;
    --text-muted: #8B93A7;
    --text-faint: #545F7A;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }
  html,body{ height:100%; }
  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    display:flex;
    min-height:100vh;
    overflow-x:hidden;
  }
  ::selection{ background: var(--amber); color: #0B0F1A; }

  a{ color:inherit; text-decoration:none; }
  button{ font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }
  button:focus-visible, a:focus-visible, input:focus-visible{
    outline: 2px solid var(--amber);
    outline-offset: 2px;
  }

  /* ---------- Sidebar ---------- */
  .sidebar{
    width: 240px;
    flex-shrink:0;
    background: var(--surface);
    border-right: 1px solid var(--line);
    padding: 28px 20px;
    display:flex;
    flex-direction:column;
    gap: 32px;
  }
  .brand{
    font-family:'Fraunces', serif;
    font-size: 1.5rem;
    font-weight:600;
    letter-spacing: 0.01em;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .brand .dot{
    width:8px; height:8px; border-radius:50%;
    background: var(--amber);
    box-shadow: 0 0 10px var(--amber);
  }
  nav.primary{ display:flex; flex-direction:column; gap:4px; }
  nav.primary .item{
    display:flex; align-items:center; gap:12px;
    padding: 9px 10px;
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }
  nav.primary .item:hover{ background: var(--surface-2); color: var(--text); }
  nav.primary .item.active{ background: var(--surface-2); color: var(--amber); }
  nav.primary svg{ width:17px; height:17px; flex-shrink:0; }

  .lib-label{
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 8px;
  }
  .playlists{ display:flex; flex-direction:column; gap:2px; overflow-y:auto; }
  .playlists .pl{
    padding: 7px 10px;
    border-radius:6px;
    font-size:0.87rem;
    color: var(--text-muted);
    transition: background 0.15s, color 0.15s;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .playlists .pl:hover{ background: var(--surface-2); color:var(--text); }

  /* ---------- Main ---------- */
  .main{
    flex:1;
    display:flex;
    flex-direction:column;
    min-width:0;
  }
  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding: 22px 36px 10px;
    gap: 20px;
  }
  .search{
    flex:1; max-width: 420px;
    display:flex; align-items:center; gap:10px;
    background: var(--surface);
    border:1px solid var(--line);
    border-radius: 999px;
    padding: 9px 16px;
  }
  .search svg{ width:15px; height:15px; color: var(--text-faint); flex-shrink:0; }
  .search input{
    background:none; border:none; color:var(--text);
    font-size:0.9rem; width:100%;
  }
  .search input::placeholder{ color: var(--text-faint); }
  .avatar{
    width:34px; height:34px; border-radius:50%;
    background: linear-gradient(135deg, var(--amber), #7C4A1E);
    flex-shrink:0;
  }

  .content{
    flex:1;
    overflow-y:auto;
    padding: 20px 36px 140px;
  }

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    border-radius: 18px;
    padding: 40px 40px;
    margin-bottom: 40px;
    background:
      radial-gradient(ellipse at 85% 20%, rgba(232,163,61,0.16), transparent 55%),
      linear-gradient(155deg, var(--surface) 0%, #0E1424 75%);
    border: 1px solid var(--line);
    overflow:hidden;
    display:flex;
    align-items:center;
    gap: 40px;
  }
  .hero-copy{ flex:1; min-width:0; }
  .hero-eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    color: var(--amber);
    letter-spacing: 0.14em;
    text-transform:uppercase;
    margin-bottom: 14px;
  }
  .hero h1{
    font-family:'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    line-height: 1.15;
    margin-bottom: 14px;
    max-width: 12ch;
  }
  .hero p{
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 42ch;
    line-height: 1.55;
    margin-bottom: 24px;
  }
  .hero-play{
    display:inline-flex; align-items:center; gap:10px;
    background: var(--amber);
    color: #1A1204;
    font-weight:600;
    font-size: 0.88rem;
    padding: 11px 22px;
    border-radius: 999px;
    transition: transform 0.15s, background 0.15s;
  }
  .hero-play:hover{ background:#f3b455; transform: translateY(-1px); }
  .hero-play svg{ width:14px; height:14px; }

  /* vinyl */
  .vinyl-wrap{
    width: 190px; height:190px; flex-shrink:0;
    position:relative;
    display:flex; align-items:center; justify-content:center;
  }
  .vinyl{
    width:170px; height:170px; border-radius:50%;
    background:
      repeating-radial-gradient(circle at center, #1c1c22 0px, #1c1c22 2px, #26262e 3px, #1c1c22 4px);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    position:relative;
    animation: spin 5s linear infinite;
    animation-play-state: paused;
  }
  .vinyl.spinning{ animation-play-state: running; }
  .vinyl::after{
    content:"";
    position:absolute; top:50%; left:50%;
    width: 58px; height:58px;
    background: radial-gradient(circle at 35% 30%, #f3b455, var(--amber-dim) 70%);
    border-radius:50%;
    transform: translate(-50%,-50%);
  }
  .vinyl::before{
    content:"";
    position:absolute; top:50%; left:50%;
    width:10px; height:10px; background:#0B0F1A; border-radius:50%;
    transform: translate(-50%,-50%);
    z-index:2;
  }
  @keyframes spin{ to{ transform: rotate(360deg); } }

  /* ---------- Section ---------- */
  .section{ margin-bottom: 40px; }
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-bottom: 16px;
  }
  .section-head h2{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size: 1.25rem;
  }
  .section-head .see-all{
    font-size:0.8rem; color: var(--text-faint);
    letter-spacing:0.04em;
  }
  .section-head .see-all:hover{ color: var(--amber); }

  .card-row{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 18px;
  }
  .card{
    background: var(--surface);
    border:1px solid var(--line);
    border-radius: 12px;
    padding: 14px;
    transition: background 0.15s, border-color 0.15s;
    position:relative;
  }
  .card:hover{ background: var(--surface-2); border-color:#33405c; }
  .cover{
    width:100%; aspect-ratio:1;
    border-radius:8px;
    margin-bottom: 12px;
    position:relative;
    overflow:hidden;
  }
  .cover .play-mini{
    position:absolute; right:8px; bottom:8px;
    width:34px; height:34px; border-radius:50%;
    background: var(--amber); color:#1A1204;
    display:flex; align-items:center; justify-content:center;
    opacity:0; transform: translateY(6px);
    transition: opacity 0.15s, transform 0.15s;
  }
  .card:hover .play-mini{ opacity:1; transform:none; }
  .play-mini svg{ width:13px; height:13px; }
  .card .title{ font-size:0.87rem; font-weight:600; margin-bottom:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .card .sub{ font-size:0.78rem; color: var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  /* ---------- Track list ---------- */
  .tracklist{ display:flex; flex-direction:column; }
  .track-row{
    display:grid;
    grid-template-columns: 28px 40px 1fr 120px 60px;
    align-items:center;
    gap: 16px;
    padding: 9px 12px;
    border-radius: 8px;
    transition: background 0.12s;
  }
  .track-row:hover{ background: var(--surface); }
  .track-row.playing .idx{ color: var(--amber); }
  .track-row.playing .t-title{ color: var(--amber); }
  .idx{ color: var(--text-faint); font-size:0.82rem; font-family:'IBM Plex Mono', monospace; text-align:center; }
  .track-row:hover .idx{ display:none; }
  .track-row .row-play{ display:none; width:20px; height:20px; align-items:center; justify-content:center; color:var(--text); }
  .track-row:hover .row-play{ display:flex; }
  .row-play svg{ width:13px; height:13px; }
  .t-cover{ width:40px; height:40px; border-radius:6px; }
  .t-title{ font-size:0.88rem; font-weight:500; }
  .t-artist{ font-size:0.78rem; color: var(--text-muted); margin-top:2px; }
  .t-album{ font-size:0.8rem; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .t-dur{ font-size:0.8rem; color:var(--text-faint); font-family:'IBM Plex Mono', monospace; text-align:right; }

  /* palette swatches for covers (no external images) */
  .p1{ background: linear-gradient(155deg,#4A3B7C,#1D1533); }
  .p2{ background: linear-gradient(155deg,#7C4A1E,#2B1A0C); }
  .p3{ background: linear-gradient(155deg,#2E5C55,#12211E); }
  .p4{ background: linear-gradient(155deg,#7C2E3C,#2A1015); }
  .p5{ background: linear-gradient(155deg,#3C5C7C,#141F2B); }
  .p6{ background: linear-gradient(155deg,#5C4A2E,#211A0F); }

  /* ---------- Now playing bar ---------- */
  .now-playing{
    position:fixed; left:240px; right:0; bottom:0;
    height: 88px;
    background: var(--surface);
    border-top: 1px solid var(--line);
    display:flex; align-items:center;
    padding: 0 24px;
    gap: 24px;
    z-index: 10;
  }
  .np-track{
    display:flex; align-items:center; gap:12px;
    width: 260px; flex-shrink:0;
  }
  .np-cover{
    width:52px; height:52px; border-radius:8px; flex-shrink:0;
    position:relative;
  }
  .np-meta .title{ font-size:0.85rem; font-weight:600; }
  .np-meta .artist{ font-size:0.76rem; color: var(--text-muted); margin-top:2px; }

  .np-center{ flex:1; display:flex; flex-direction:column; align-items:center; gap:8px; max-width: 560px; margin:0 auto; }
  .np-controls{ display:flex; align-items:center; gap:20px; }
  .np-controls button{ color: var(--text-muted); transition: color 0.15s, transform 0.15s; }
  .np-controls button:hover{ color: var(--text); }
  .np-controls svg{ width:16px; height:16px; }
  .play-toggle{
    width:34px; height:34px; border-radius:50%;
    background: var(--text);
    color: var(--bg) !important;
    display:flex; align-items:center; justify-content:center;
  }
  .play-toggle:hover{ transform: scale(1.05); }
  .play-toggle svg{ width:14px; height:14px; }

  .np-progress{ display:flex; align-items:center; gap:10px; width:100%; }
  .np-progress span{ font-size:0.7rem; color:var(--text-faint); font-family:'IBM Plex Mono', monospace; width:34px; }
  .np-progress span:last-child{ text-align:left; }
  .bar{
    flex:1; height:4px; background: var(--line); border-radius:2px;
    position:relative; cursor:pointer;
  }
  .bar-fill{
    position:absolute; left:0; top:0; height:100%;
    background: var(--amber); border-radius:2px; width:0%;
  }
  .bar-fill::after{
    content:""; position:absolute; right:-5px; top:50%; transform:translateY(-50%);
    width:10px; height:10px; border-radius:50%; background: var(--text);
    opacity:0; transition:opacity 0.15s;
  }
  .bar:hover .bar-fill::after{ opacity:1; }

  .np-right{ width:220px; flex-shrink:0; display:flex; align-items:center; justify-content:flex-end; gap:14px; }
  .waveform{ display:flex; align-items:flex-end; gap:2px; height:20px; }
  .waveform i{
    width:2.5px; background: var(--amber-dim); border-radius:2px;
    height:4px;
    transition: height 0.12s ease;
  }
  .waveform.active i{ background: var(--amber); }
  .vol{ display:flex; align-items:center; gap:8px; width:90px; }
  .vol svg{ width:15px; height:15px; color:var(--text-muted); flex-shrink:0; }
  .vol .bar{ height:3px; }

  @media (max-width: 900px){
    .sidebar{ display:none; }
    .now-playing{ left:0; }
    .np-track{ width:180px; }
    .np-right{ display:none; }
  }
  @media (prefers-reduced-motion: reduce){
    .vinyl, .waveform i{ animation:none !important; transition:none !important; }
  }
</style>
